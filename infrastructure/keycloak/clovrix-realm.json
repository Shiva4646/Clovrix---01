{
  "realm": "clovrix",
  "enabled": true,
  "displayName": "Clovrix Compliance Platform",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 43200,
  "accessTokenLifespanForImplicitFlow": 43200,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Full platform access including tenant management"
      },
      {
        "name": "compliance_admin",
        "description": "Compliance Admin — creates audits and manages the audit cycle"
      },
      {
        "name": "lead_auditor",
        "description": "Create and manage audit workflows and findings"
      },
      {
        "name": "reviewer",
        "description": "Review and approve findings and remediations"
      },
      {
        "name": "read_only",
        "description": "View-only access to all compliance data"
      },
      {
        "name": "control_lead",
        "description": "Enrich and prepare assigned audit controls"
      },
      {
        "name": "assessor",
        "description": "Test controls and raise findings"
      },
      {
        "name": "risk_owner",
        "description": "Manage risks and vendor assessments"
      }
    ]
  },
  "clients": [
    {
      "clientId": "clovrix-api",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "secret": "clovrix-api-secret-change-in-prod",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5000/*",
        "*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clovrix-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
