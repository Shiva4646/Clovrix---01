# Copy this file to .env before starting the stack.
# Use a separate secure channel for real credentials and change all secrets.

Clovrix_ENV=development
Clovrix_VERSION=1.0.0

POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_DB=clovrix
POSTGRES_USER=clovrix
POSTGRES_PASSWORD=replace-with-a-strong-password
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25

VALKEY_PASSWORD=replace-with-a-strong-password

RABBITMQ_USER=clovrix
RABBITMQ_PASSWORD=replace-with-a-strong-password
RABBITMQ_VHOST=/

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password
KEYCLOAK_REALM=clovrix
KEYCLOAK_CLIENT_ID=clovrix-api

MINIO_ROOT_USER=clovrix-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_REGION=us-east-1

OPENBAO_ROOT_TOKEN=replace-with-a-random-token
OPENBAO_ADDR=http://openbao:8200
MEILI_MASTER_KEY=replace-with-a-random-key
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@clovrix.local

OLLAMA_MODEL=llama3.2:1b
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=http://keycloak:8080/realms/clovrix
JWT_AUDIENCE=clovrix-api

FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
